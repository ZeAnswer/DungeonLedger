  "abilities": [
    {
      "id": "favored-enemy-1",
      "name": "Favored Enemy (1st)",
      "text": "+2 on Bluff, Listen, Sense Motive, Spot and Survival checks and weapon damage rolls against the chosen creature type. Increases by +2 at ranger levels 5, 10, 15, 20 (choose which favored enemy improves).",
      "sourceRef": "PHB p.47",
      "scripts": [
        {
          "id": "fe",
          "label": "Favored enemy",
          "events": [
            "always"
          ],
          "source": "fn.favoredEnemy({ types: params.types, amount: vars.favoredEnemyBonus1 });",
          "enabled": true,
          "priority": 0
        }
      ],
      "kind": "feature",
      "acquired": {
        "kind": "class"
      },
      "params": {
        "types": {
