      "id": "point-blank-shot",
      "name": "Point Blank Shot",
      "text": "+1 on attack and damage rolls with ranged weapons at ranges up to 30 feet.",
      "sourceRef": "PHB p.98",
      "scripts": [
        {
          "id": "pbs",
          "label": "Point Blank Shot",
          "events": [
            "always"
          ],
          "source": "if (attack.isRanged && target.within(30)) {\n  bonus('attack', 1);\n  bonus('damage', 1);\n}",
