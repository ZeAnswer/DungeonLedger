  "functions": [
    {
      "id": "trophy",
      "name": "Trophy bonus",
      "description": "A Monster Hunter trophy bonus, multiplied by the character's trophyMultiplier (×2 at MH5, ×3 at MH10).",
      "params": [
        {
          "name": "stat",
          "type": "stat",
          "label": "Stat",
          "required": true
        },
        {
          "name": "base",
          "type": "number",
          "label": "Base bonus",
          "required": true
        },
        {
          "name": "type",
          "type": "bonusType",
          "label": "Bonus type",
          "default": "enhancement",
          "required": false
        }
      ],
      "source": "bonus(stat, base * (vars.trophyMultiplier ?? 1), type);"
    }
  ],
