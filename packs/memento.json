    {
      "id": "weapon-focus-longbow",
      "name": "Weapon Focus (longbow)",
      "text": "+1 on attack rolls with longbows.",
      "sourceRef": "PHB p.102",
      "scripts": [
        {
          "id": "wf",
          "events": [
            "always"
          ],
          "source": "if (attack.weapon.is('longbow')) {\n  bonus('attack', 1);\n}",
          "enabled": true,
          "priority": 0
        }
      ],
      "kind": "feature",
      "acquired": {
        "kind": "feat"
      },
      "enabledByDefault": true,
      "activations": [],
      "pools": []
    },
    {
      "id": "woodland-archer",
      "name": "Woodland Archer",
      "text": "Adjust for Range: after missing a foe with a ranged attack, +4 on later ranged attacks vs that foe this round (DM ruling: stacks per miss). Pierce the Foliage: after hitting despite concealment, next round your ranged attacks vs that foe ignore that concealment. Moving Sniper: after a successful sniping attack you may move once before re-hiding.",
      "sourceRef": "Races of the Wild p.154",
      "scripts": [
        {
          "id": "adjust",
          "label": "Adjust for Range",
          "events": [
            "always"
          ],
          "source": "if (attack.isRanged) {\n  need(history('miss') >= 1, 'you missed this target this round');\n  bonus('attack', 4 * history('miss'));\n}",
          "enabled": true,
          "priority": 0
        },
        {
          "id": "pierce",
          "label": "Pierce the Foliage",
          "events": [
            "always"
          ],
          "source": "if (attack.isRanged && target.is('concealed')) {\n  need(history('hit', { since: 'lastRound' }) >= 1, 'you hit this target last round');\n  flag('ignoreConcealment');\n  note(`Pierce the Foliage: ignore this foe's concealment miss chance this round.`);\n}",
          "enabled": true,
          "priority": 0
        },
        {
          "id": "sniper",
          "label": "Moving Sniper",
          "events": [
            "always"
          ],
          "source": "if (battle.on('sniping')) {\n  note('Moving Sniper: after a hit while sniping, take one move action before re-hiding.');\n}",
          "enabled": true,
          "priority": 0
        }
      ],
      "kind": "feature",
      "acquired": {
        "kind": "feat"
      },
      "enabledByDefault": true,
      "activations": [],
      "pools": []
    },
    {
      "id": "knowledge-devotion",
      "name": "Knowledge Devotion",
      "text": "Once per creature type per combat, make a Knowledge check (need 1+ rank in the matching Knowledge skill). Insight bonus on attack and damage vs that type: 15 or less +1, 16-25 +2, 26-30 +3, 31-35 +4, 36+ +5.",
      "sourceRef": "Complete Champion",
      "scripts": [
        {
          "id": "kd",
          "label": "Knowledge Devotion",
          "events": [
            "always"
          ],
          "source": "const knowledge = ask('knowledge', { per: 'creatureType' });\nif (knowledge) {\n  bonus('attack', tier(knowledge, [15, 1], [25, 2], [30, 3], [35, 4], [Infinity, 5]), 'insight');\n  bonus('damage', tier(knowledge, [15, 1], [25, 2], [30, 3], [35, 4], [Infinity, 5]), 'insight');\n}",
          "enabled": true,
          "priority": 0
        }
      ],
      "kind": "feature",
      "acquired": {
        "kind": "feat"
      },
      "enabledByDefault": true,
      "activations": [],
      "pools": []
    },
    {
      "id": "distracting-attack",
      "name": "Distracting Attack",
      "text": "Whenever you hit an enemy with a weapon attack, that enemy is considered flanked by you until the end of your next turn.",
      "sourceRef": "PHB2 ranger variant (replaces animal companion)",
      "todo": "Confirm exact duration and whether the flank counts for you or only allies.",
      "scripts": [
        {
          "id": "flank",
          "events": [
            "hit"
          ],
          "source": "target.mark('flanked', UNTIL_MY_NEXT_TURN);",
